@model CommentDto



    <div class="d-flex">
        <div class="user-img">
            <img src="@Model.ProfilePhotoUrl" alt="userimg" style="width: 50px; height: 50px; object-fit: cover;">
        </div>
        <div class="comment-data-block">
            <h6>@Model.UserName</h6>
            <p>@Model.Text</p>
            <div class="d-flex flex-wrap align-items-center comment-activity">
                <a href="javascript:void();">Like</a>
                <a href="javascript:void();">Reply</a>
                <span>@Model.CreatedTime</span>
            <span>@Model.CreatedTime</span>  <a class="cCc" asp-controller="Comment" asp-action="Delete" asp asp-route-commentUserId="@Model.Id" asp-route-postUserId="@Model.PostId">
                x
            </a>

            <style>
                .cCc {
                    position: relative;
                    bottom: 40px;
                    right: 3px;
                    color: red;
                    cursor: pointer;
                    font-size: 14px;
                    font-weight: bold;
                }
            </style>
            </div>
        </div>
    </div>

    <style>
        .d-flex{
            margin-top:10px;
        }
    </style>