@model CommentDto
<li>
    <div class="d-flex">
        <div class="user-img">
            <img src="@Model.ProfilePhotoUrl" alt="userimg" style="width: 50px; height: 50px; object-fit: cover;">
        </div>
        <div class="comment-data-block">
            <h6>@Model.UserName</h6>
            <p>@Model.Text</p>
            <div class="d-flex flex-wrap align-items-center comment-activity">
                <a href="javascript:void(0);" class="reply-toggle" onclick="toggleReplyInput(this);">Reply</a>
                <a href="javascript:void();">Like</a>
                <a href="javascript:void();">Translate</a>
                <span>@Model.CreatedTime</span>
                <a class="ccc" asp-controller="Comment" asp-action="Delete" asp asp-route-commentUserId="@Model.Id" asp-route-postUserId="@Model.PostId">
                    x
                </a>

                <style>
                    .ccc {
                        position: relative;
                        bottom: 70px;
                        right: 3px;
                        color: red;
                        cursor: pointer;
                        font-size: 14px;
                        font-weight: bold;
                    }
                </style>
            </div>
        </div>
    </div>

    <form class="reply-input" asp-controller="Post" asp-action="ReplyComment" method="post" style="display: none;">
        <input type="hidden" name="PostId" value="@Model.PostId" />
        <input type="hidden" name="ParentId" value="@Model.Id" />
        <input type="text" name="Text" placeholder="Reply to this comment" required />
        <button type="submit">Reply</button>
    </form>

    <!-- Child Comments -->
    @foreach (var child in Model.Children)
    {
    <li class="child-comment">
        <div class="d-flex">
            <div class="user-img">
                <img src="@Model.ProfilePhotoUrl" alt="userimg" style="width: 50px; height: 50px; object-fit: cover;">
            </div>
            <div class="comment-data-block">
                <h6>@child.UserName</h6>
                <p>@child.Text</p>
                <div class="d-flex flex-wrap align-items-center comment-activity">
                    <a href="javascript:void();">Like</a>
                    <a href="javascript:void();">Reply</a>
                    <span>@child.CreatedTime</span>
                    <a class="cCc" asp-controller="Comment" asp-action="Delete" asp asp-route-commentUserId="@Model.Id" asp-route-postUserId="@Model.PostId">
                        x
                    </a>

                    <style>
                        .cCc {
                            position: relative;
                            bottom: 40px;
                            right: 3px;
                            color: red;
                            cursor: pointer;
                            font-size: 14px;
                            font-weight: bold;
                        }
                    </style>

                </div>
            </div>
        </div>
    </li>
    }
                                            </li>