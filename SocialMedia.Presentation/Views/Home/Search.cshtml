@using SocalMedia.Business.Dtos.SearchDtos
@using SocialMedia.Core.Entities
@model SearchUsersDto

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/assets/css/bootstrap/bootstrap.css">
    <link rel="stylesheet" href="~/assets/css/bootstrap/bootstrap-grid.css">
    <link rel="stylesheet" href="~/assets/css/bootstrap/bootstrap-utilities.css">
    <link rel="stylesheet" href="~/assets/css/bootstrap/bootstrap-reboot.css">
    <link rel="stylesheet" href="~/assets/css/socialv.css">
    <title>Search</title>
</head>

<div class="user-card-container">
    @if (Model?.SearchDtos == null || !Model.SearchDtos.Any())
    {
        <H1>NOT FOUND</H1>
    }
    else
    {
        @foreach (var user in Model.SearchDtos)
        {
            <a asp-controller="Profile" asp-action="ProfileUser" asp-route-userId="@user.UserId" class="user-card">
                <div class="user-card-content">
                    <img src="@user.ProfileImage" alt="Profil Foto" class="profile-image">
                    <div class="user-info">@user.UserName</div>
                </div>
            </a>
        }
    }
</div>

<style>
    h1 {
        text-align: center;
        margin-top: 50px;
        display: flex;
    }

    .user-card-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr); /* 1 sırada 4 sütun */
        gap: 15px; /* Kartlar arasında boşluk */
        padding: 15px;
        max-width: 1000px;
        margin: 0 auto; /* Ortada göster */
    }

    .user-card {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        background-color: #fff;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .user-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

    .profile-image {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
        margin-right: 15px;
    }

    .user-card .user-info {
        font-size: 16px;
        font-weight: bold;
        color: #333;
    }

    .user-card-content {
        display: flex;
        align-items: center;
    }
</style>
