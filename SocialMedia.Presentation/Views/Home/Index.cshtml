        function openStory(stories) {
            console.log(stories)
            allStories = stories;
            currentStoryIndex = 0;
            document.getElementById("storyImage").src = allStories[currentStoryIndex];
            document.getElementById("storyModal").style.display = "flex";
            startAutoChange();
        }

        function closeStory() {
            document.getElementById("storyModal").style.display = "none";
            clearInterval(autoChange);
        }

        function nextStory() {
            if (currentStoryIndex < allStories.length - 1) {
                currentStoryIndex++;
                document.getElementById("storyImage").src = allStories[currentStoryIndex].url;
                resetAutoChange();
            } else {
                closeStory();
            }
        }

        function prevStory() {
            if (currentStoryIndex > 0) {
                currentStoryIndex--;
                document.getElementById("storyImage").src = allStories[currentStoryIndex].url;
                resetAutoChange();
            }
        }

        function startAutoChange() {
            autoChange = setInterval(nextStory, 15000);
        }

        function resetAutoChange() {
            clearInterval(autoChange);
            startAutoChange();
        }

        fetchStories();
    </script>

