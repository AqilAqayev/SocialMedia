@using SocalMedia.Business.Dtos.StoryDtos
@model List<StoryDto>

<body>
    <div class="custom-layout">
        <div class="content">
            <div class="user-section">
                @foreach (var story in Model)
                {
                    <div class="profile">
                        <img src="~/assets/images/profile1.jpg" alt="Profil Şəkli">
                        <p>Aqil</p>
                    </div>
                    <div class="media">
                        @foreach (var image in story.StoryImages)
                        {
                            <div class="media-item">
                                <img src="@image" alt="Story Image" style="width: 100px; height: 100px; object-fit: cover;" />
                            </div>
                        }
                        @foreach (var video in story.StoryVideos)
                        {
                            <div class="media-item">
                                <video controls src="@video" style="width: 100px; height: 100px; object-fit: cover;"></video>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</body>

<style>
    /* Sizin xüsusi kontent üçün əsas sinif */
    .custom-layout {
        position: relative;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
        overflow: hidden; /* Kənara çıxmağı əngəlləyir */
    }

        .custom-layout .content {
            padding: 20px;
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }

        .custom-layout .user-section {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-left: 100px; /* Sol tərəfdəki layout üçün boşluq */
        }

        .custom-layout .profile {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-bottom: 20px;
        }

            .custom-layout .profile img {
                width: 80px;
                height: 80px;
                border-radius: 50%;
                border: 2px solid #ccc;
            }

            .custom-layout .profile p {
                margin-top: 10px;
                font-size: 14px;
                font-weight: bold;
            }

        .custom-layout .media {
            display: flex;
            flex-wrap: wrap; /* Şəkil və videoların yeni sətirə düşməsi üçün */
            gap: 15px;
            justify-content: flex-start;
        }

        .custom-layout .media-item {
            width: calc(25% - 15px);
            max-width: 220px;
            height: 150px;
            background-color: #ddd;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #bbb;
            font-size: 12px;
            flex-grow: 1;
        }

            .custom-layout .media-item img,
            .custom-layout .media-item video {
                max-width: 100%;
                max-height: 100%;
                object-fit: cover;
            }
</style>
