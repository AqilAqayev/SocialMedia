@using SocalMedia.Business.Dtos.StoryDtos

@model List<UserStoriesDto>

    <style>
    .stories-container {
        display: flex;
        gap: 20px;
        padding: 20px;
        overflow-x: auto;
        background-color: #f9f9f9;
    }

        .stories-container .content {
            position: relative;
            width: 90px;
            text-align: center;
            flex-shrink: 0;
        }

            .stories-container .content img {
                width: 90px;
                height: 90px;
                border-radius: 50%;
                object-fit: cover;
                box-shadow: 0 0 6px rgba(0, 0, 0, 0.2);
            }

            .stories-container .content p {
                margin-top: 5px;
                font-size: 14px;
                color: #333;
            }

    .story-full {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        justify-content: center;
        align-items: center;
    }

        .story-full.active {
            display: flex;
        }

        .story-full .content {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            max-width: 90%;
            max-height: 90%;
        }

        .story-full img {
            max-width: 100%;
            max-height: 80%;
            border-radius: 10px;
        }

        .story-full .close-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            cursor: pointer;
            font-size: 20px;
            color: white;
        }

        .story-full .left-arrow, .story-full .right-arrow {
            position: absolute;
            top: 50%;
            font-size: 30px;
            color: white;
            cursor: pointer;
        }

        .story-full .left-arrow {
            left: 10px;
        }

        .story-full .right-arrow {
            right: 10px;
        }

        .story-full .title {
            margin-top: 10px;
            color: white;
            font-size: 18px;
        }

    </style>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stories</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="stories-container">
    </div>

    <div class="story-full">
        <div class="content">
            <div class="close-btn">X</div>
            <div class="left-arrow">←</div>
            <img src="" alt="Story Image">
            <div class="right-arrow">→</div>
            <div class="title"></div>
        </div>
    </div>

    <script src="~/assets/js/story.js"></script>
</body>
</html>



