@using SocalMedia.Business.Dtos.ProfileDtos
@model EditProfileDto


<section class="container mt-4">
    <h2>Edit Profile</h2>

    <form asp-action="EditProfile" enctype="multipart/form-data" method="post">
        <div class="form-group mb-3">
            <label for="UserName">Username</label>
            <input asp-for="UserName" class="form-control" placeholder="Enter your username" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label for="Bio">Bio</label>
            <textarea asp-for="Bio" class="form-control" placeholder="Tell us about yourself"></textarea>
            <span asp-validation-for="Bio" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label for="PhoneNumber">Phone Number</label>
            <input asp-for="PhoneNumber" class="form-control" placeholder="Enter your phone number" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label for="ProfilePhoto">Profile Photo</label>
            <input asp-for="ProfilePhoto" type="file" class="form-control" />
            <span asp-validation-for="ProfilePhoto" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsPrivate" class="form-check-input" type="checkbox" id="IsPrivate" />
            <label class="form-check-label" for="IsPrivate">
                Make Profile Private
            </label>
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </form>
</section>
